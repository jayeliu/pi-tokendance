    "url": "git+https://github.com/jayeliu/pi-tokendance.git"
  },
  "bugs": {
    "url": "https://github.com/jayeliu/pi-tokendance/issues"
  },
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
